{
  "languages": {
    "C++": {
      "format_on_save": "off",
    },
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "rustfmt": {
          "extraArgs": ["+nightly"],
        },
        "cargo": {
          "target": "arm-unknown-linux-gnueabi",
          "buildScripts": {
            "enable": true,
          },
        },
        "procMacro": {
          "enable": true,
        },
        "inlayHints": {
          "maxLength": 10,
        },
      },
    },
  },
}
